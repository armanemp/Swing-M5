<Project>
  <!-- The cTrader.Automate package extracts bundle metadata before SDK defaults
       reliably pick up a nested project's assembly name. Force the .algo metadata
       to use the explicit AlgoName, matching the working CT-TraderBot build setup. -->
  <Target Name="FixCTraderAlgoMetadata"
          BeforeTargets="_ExtractMetadata"
          Condition="'$(AlgoBuild)' == 'true'">
    <PropertyGroup>
      <_AlgoFileName>$(AlgoName).algo</_AlgoFileName>
      <_AlgoFilePath>$(OutDir)$(_AlgoFileName)</_AlgoFilePath>
      <_AlgoMetadataFileName>$(_AlgoFileName).metadata</_AlgoMetadataFileName>
      <_AlgoMetadataFilePath>$(OutDir)$(_AlgoMetadataFileName)</_AlgoMetadataFilePath>
    </PropertyGroup>
  </Target>
</Project>
