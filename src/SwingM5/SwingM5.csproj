<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>cAlgo.Indicators</RootNamespace>
    <AssemblyName>SwingM5</AssemblyName>
    <AlgoName>SwingM5</AlgoName>
    <AlgoBuild>true</AlgoBuild>
    <AlgoPublish>true</AlgoPublish>
    <IncludeSource>false</IncludeSource>
    <IncludeSymbols>false</IncludeSymbols>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="cTrader.Automate" Version="1.0.21" />
  </ItemGroup>
</Project>
